# Copiar a .env y ajustar. Ver docs/entorno.md.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sgsm:sgsm@localhost:5432/sgsm?schema=public

# Sesión (T105). JWT_SECRETO es obligatorio en producción: usar una cadena larga y aleatoria.
JWT_SECRETO=cambiar-por-una-clave-larga-y-aleatoria
SESION_INACTIVIDAD_MIN=15
SESION_MAXIMA_HORAS=12
# true solo si se sirve por HTTPS (en producción es true por defecto)
COOKIE_SEGURA=false
BCRYPT_COSTO=10

# Bloqueo por intentos fallidos (T112)
LOGIN_MAX_INTENTOS=3
LOGIN_BLOQUEO_MIN=15
