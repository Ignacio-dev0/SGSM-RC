# Copiar a .env y ajustar. Ver docs/entorno.md.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sgsm:sgsm@localhost:5432/sgsm?schema=public

# Sesión (T105). JWT_SECRETO es obligatorio en producción: usar una cadena larga y aleatoria.
JWT_SECRETO=cambiar-por-una-clave-larga-y-aleatoria
SESION_INACTIVIDAD_MIN=15
SESION_MAXIMA_HORAS=12
# true solo si se sirve por HTTPS (en producción es true por defecto)
COOKIE_SEGURA=false
BCRYPT_COSTO=10

# Bloqueo por intentos fallidos (T112)
LOGIN_MAX_INTENTOS=3
LOGIN_BLOQUEO_MIN=15
# Límite de fallidos por IP en el login (T705): 0 lo desactiva
LOGIN_IP_MAX_FALLIDOS=10
LOGIN_IP_VENTANA_MIN=15
# Proxies delante de la API (nginx o el de Vite): 1. false si la API se expone sin proxy.
CONFIAR_PROXY=1

# Biometría (T404, T407)
BIOMETRIA_UMBRAL=0.5
BIOMETRIA_MAX_INTENTOS=3
BIOMETRIA_VALIDEZ_SEG=120
# Cifrado del patrón y la foto (T705 · docs/seguridad.md). 32 bytes en base64 o hex; obligatoria
# en producción. Vacía en desarrollo usa la clave de desarrollo. Para generar una:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BIOMETRIA_CLAVE=
# Solo durante una rotación: la clave anterior (después se borra)
BIOMETRIA_CLAVE_ANTERIOR=

# Suministros (CU23)
SUMINISTRO_PLAZO_CORRECCION_HORAS=24

# Recordatorios de tomas (E5 · docs/diseno-e5.md, supuestos S9–S11)
RECORDATORIOS_TEMPORIZADOR=true
RECORDATORIOS_INTERVALO_SEG=60
RECORDATORIO_ANTICIPACION_MIN=30
RECORDATORIO_VENCIMIENTO_MIN=60
RECORDATORIO_PRIORIDAD_ALTA_MIN=5
RECORDATORIO_PRIORIDAD_MEDIA_MIN=15
RECORDATORIO_VENCIDOS_VISIBLES_HORAS=12

# Tiempo real por WebSocket (T505 · docs/recordatorios.md)
TIEMPO_REAL_LATIDO_SEG=30
# Orígenes aceptados además del propio, separados por comas (ej.: http://localhost:8080)
TIEMPO_REAL_ORIGENES=
