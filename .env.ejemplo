# Configuración del despliegue con Docker Compose en la PC servidor del hospital (T801, T802).
# Copiar a .env (no se versiona), completar y seguir docs/despliegue.md. Sin comillas ni
# comentarios al final de una línea.

# Perfil que levanta `docker compose up -d`: API, interfaz por HTTPS y respaldo diario. Con el
# perfil activado acá, compose se niega a arrancar si falta alguno de los secretos de abajo.
COMPOSE_PROFILES=completo

# ---- Servidor (van en el certificado HTTPS: scripts/certificado.sh) ----
# Nombres con que las tablets entran al sistema, separados por comas (el que dé el DNS del
# hospital, o el nombre de la PC terminado en .local).
SGSM_SERVIDOR=sgsm.local
# IP fija de esta PC en la red del hospital (reservada en el DHCP), separadas por comas.
SGSM_IP=192.168.1.50

# ---- Puertos de la PC ----
# HTTPS de la interfaz. En el servidor conviene 443 (y 80 para HTTP): las tablets entran con
# https://sgsm.local sin escribir puerto.
HTTPS_PUERTO=8443
# HTTP: solo redirige a HTTPS y sirve la CA para instalar en las tablets.
HTTP_PUERTO=8080
# PostgreSQL solo desde esta PC (no desde la red): dirección y puerto.
DB_PUERTO=127.0.0.1:5432

# ---- Secretos (obligatorios) ----
# Firma de las sesiones. Generar con: openssl rand -base64 48
JWT_SECRETO=
# Cifrado del patrón facial y la foto en reposo: 32 bytes en base64. Generar con:
# openssl rand -base64 32
# Guardar una copia FUERA de esta PC y aparte de los respaldos: si se pierde, los rostros
# registrados no se pueden leer y hay que registrarlos de nuevo. No cambiarla a mano: para
# rotarla, docs/despliegue.md ("Rotar la clave biométrica").
BIOMETRIA_CLAVE=
# Solo durante una rotación: la clave anterior, para volver a cifrar con la nueva.
BIOMETRIA_CLAVE_ANTERIOR=
# Contraseña de PostgreSQL, solo letras y números. Generar con: openssl rand -hex 24
# Se aplica al crear la base la primera vez; después no se cambia acá sin cambiarla en la base.
POSTGRES_CLAVE=

# ---- Inicio de sesión ----
# Límite de fallidos por IP del login (docs/seguridad.md). Con Docker Desktop en Windows la API ve a
# TODAS las tablets con la misma IP (la de Docker: revisar con docker compose logs frontend), así
# que el límite pasa a ser para todo el hospital y unos pocos errores de tipeo en un cambio de
# turno frenarían el ingreso de todos. 0 lo apaga y queda el bloqueo de cada cuenta (3 intentos).
# En un servidor Linux, donde la IP de cada tablet llega bien, dejarlo vacío (10 por defecto).
LOGIN_IP_MAX_FALLIDOS=0

# ---- Respaldos ----
# Hora del respaldo diario (HH:MM, hora de Argentina).
RESPALDO_HORA=03:00
# Cantidad de respaldos diarios que se guardan (los manuales no se borran solos).
RESPALDO_RETENCION=14
# Carpeta de los respaldos. Mejor en otro disco o en una carpeta sincronizada (D:/respaldos-sgsm).
RESPALDO_CARPETA=./respaldos

# ---- Interfaz (se fija al construir la imagen) ----
# camara, o simulado para demostraciones sin cámara.
VITE_BIOMETRIA_MODO=camara
